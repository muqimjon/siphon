# Domains (point both at the server in Cloudflare DNS, media host as DNS-only)
WEB_DOMAIN=siphon.example.uz
BOT_DOMAIN=bot.siphon.example.uz
ACME_EMAIL=you@example.com

# Database
POSTGRES_PASSWORD=change-me

# Accounts
JWT_SECRET=at-least-32-characters-long-random-string
ADMIN_EMAIL=you@example.com

# First-party API keys (any random strings, keep them secret)
WEB_API_KEY=change-me
BOT_API_KEY=change-me
EXTENSION_API_KEY=change-me

# Telegram
BOT_TOKEN=
BOT_USERNAME=

# OAuth (leave empty to hide the provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
